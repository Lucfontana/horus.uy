{
  "name": "horus.uy",
  "version": "1.0.0",
  "description": "Proyecto final del programa \"Jóvenes Creativos\"",
  "type": "module",
  "main": "server/server.js",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --watch server/server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src vite.config.js eslint.config.js backend/filter_products.js",
    "demo": "node --env-file-if-exists=.env server/server.js --fixtures",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --test server/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucfontana/horus.uy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Lucfontana/horus.uy/issues"
  },
  "homepage": "https://github.com/Lucfontana/horus.uy#readme",
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "mongoose": "^9.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  }
}
